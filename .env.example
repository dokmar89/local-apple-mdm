MDM_HOSTNAME=macbook.local
MDM_PORT=8443
MDM_LAN_IP=192.168.1.50
MDM_ORG_NAME=ExampleOrg
MDM_TOPIC=com.apple.mgmt.External.00000000-0000-0000-0000-000000000000
MDM_KEY=ca/server.key
MDM_CERT=ca/server.crt
MDM_CA=ca/root-ca.crt
MDM_PROFILE=ca/iphone.mobileconfig
MDM_DB=data/mdm.sqlite
# Generate both with: openssl rand -hex 32
MDM_API_TOKEN=replace-with-at-least-32-random-characters
MDM_ENROLL_TOKEN=replace-with-at-least-32-random-characters
# Optional until an Apple MDM push certificate exists:
# MDM_PUSH_CERT=ca/push-cert.pem
# MDM_PUSH_KEY=ca/push-key.pem
MDM_DEBUG_CAPTURE=false
LOG_LEVEL=info
